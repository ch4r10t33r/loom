// Q6_K matvec, vectorized: word loads over the ql/qh planes, signed
// per-16 scales, vec4 activations. Value = d*sc*(q-32).
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint w4[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared float red[64];

// Unaligned 4-byte load: the 22/34/210-byte block formats put fields at
// half-word offsets. The device layer pads every buffer by a word, so the
// word+1 read at the tail stays in bounds.
uint loadU32(uint byte_off) {
    uint word = byte_off >> 2u;
    uint sh = (byte_off & 3u) * 8u;
    if (sh == 0u) return w4[word];
    return (w4[word] >> sh) | (w4[word + 1u] << (32u - sh));
}

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

const uint QK_K = 256u;
const uint BLK = 210u;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) return;
    uint tid = gl_LocalInvocationID.x;
    uint blocks = pc.cols / QK_K;
    uint row_base = row * blocks * BLK;
    uint x0 = 0u;

    // Thread t owns run (t & 7) -- half n = run>>2, run k = run&3 -- and
    // strides super-blocks by 8, exactly the layout matvecQ6K walks.
    float acc = 0.0;
    uint run = tid & 7u;
    uint n = run >> 2u;
    uint k = run & 3u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint blk = row_base + b * BLK;
        float d = unpackHalf2x16(loadU32(blk + 208u)).x;
        uint scw = loadU32(blk + 192u + n * 8u + k * 2u);
        float sc0 = float(bitfieldExtract(int(scw), 0, 8));
        float sc1 = float(bitfieldExtract(int(scw), 8, 8));
        uint ql = blk + n * 64u + ((k & 1u) == 1u ? 32u : 0u);
        uint qh = blk + 128u + n * 32u;
        uint xb4 = (x0 >> 2u) + b * 64u + n * 32u + k * 8u;
        float s0 = 0.0;
        float s1 = 0.0;
        for (uint j = 0u; j < 8u; j++) {
            uint qlw = loadU32(ql + 4u * j);
            uint qhw = loadU32(qh + 4u * j);
            vec4 lo4 = (k < 2u) ? vec4(float(qlw & 15u), float((qlw >> 8u) & 15u), float((qlw >> 16u) & 15u), float((qlw >> 24u) & 15u))
                                : vec4(float((qlw >> 4u) & 15u), float((qlw >> 12u) & 15u), float((qlw >> 20u) & 15u), float((qlw >> 28u) & 15u));
            uint sh = 2u * k;
            vec4 hi4 = vec4(float((qhw >> sh) & 3u), float((qhw >> (8u + sh)) & 3u), float((qhw >> (16u + sh)) & 3u), float((qhw >> (24u + sh)) & 3u));
            vec4 v = (lo4 + hi4 * 16.0 - 32.0) * x4[xb4 + j];
            if (j < 4u) s0 += sum4(v); else s1 += sum4(v);
        }
        acc += d * (sc0 * s0 + sc1 * s1);
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) o[row] = red[0];
}
