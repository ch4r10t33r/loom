// Q4_K matvec for a *selected* expert, indexed on the device -- the Vulkan
// port of dmmv_q4k_id.metal's role (ggml_mul_mat_id): slot s reads plane
// ids[s] of the 3D expert tensor and writes rows [s*rows, (s+1)*rows) of the
// output. x_stride selects between one shared activation vector (gate/up:
// zero) and per-slot vectors (down: the ffn width). Row arithmetic is
// identical to dmmv_q4k.comp, deliberately -- the two must agree plane for
// plane, which is what the differential asserts.
#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint8_t w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; } pc;
shared float red[64];

float halfAt(uint off) {
    uint lo = uint(w[off]);
    uint hi = uint(w[off + 1u]);
    return unpackHalf2x16(lo | (hi << 8u)).x;
}

const uint QK_K = 256u;
const uint BLK = 144u;

void scale_min(uint j, uint base, out float sc, out float mn) {
    uint a = uint(w[base + j]);
    uint b = uint(w[base + j + 4u]);
    uint c = uint(w[base + (j & 3u)]);
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

void main() {
    uint g = gl_WorkGroupID.x;
    uint slot = g / pc.rows;
    if (slot >= pc.n_used) return;
    uint row = g - slot * pc.rows;
    uint tid = gl_LocalInvocationID.x;
    uint blocks = pc.cols / QK_K;
    uint row_base = ids[slot] * pc.plane_stride + row * blocks * BLK;
    uint x0 = slot * pc.x_stride;

    float acc = 0.0;
    uint sb = tid & 7u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint blk = row_base + b * BLK;
        float d = halfAt(blk);
        float dmin = halfAt(blk + 2u);
        float sc, mn;
        scale_min(sb, blk + 4u, sc, mn);
        uint h = sb >> 1u;
        bool hi = (sb & 1u) == 1u;
        uint qs = blk + 16u + h * 32u;
        uint xb = x0 + b * QK_K + sb * 32u;
        float s_qx = 0.0;
        float s_x = 0.0;
        for (uint i = 0u; i < 32u; i++) {
            uint byte_v = uint(w[qs + i]);
            float q = float(hi ? (byte_v >> 4u) : (byte_v & 0xFu));
            float xv = x[xb + i];
            s_qx += q * xv;
            s_x += xv;
        }
        acc += d * sc * s_qx - dmin * mn * s_x;
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) o[slot * pc.rows + row] = red[0];
}
