// Q4_K id-indexed matvec (ggml_mul_mat_id), four rows per workgroup; row
// arithmetic identical to dmmv_q4k.comp, deliberately.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint w4[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; uint base; } pc;
shared vec4 red[64];

// Unaligned 4-byte load: the 22/34/210-byte block formats put fields at
// half-word offsets. The device layer pads every buffer by a word, so the
// word+1 read at the tail stays in bounds.
uint loadU32(uint byte_off) {
    uint word = byte_off >> 2u;
    uint sh = (byte_off & 3u) * 8u;
    if (sh == 0u) return w4[word];
    return (w4[word] >> sh) | (w4[word + 1u] << (32u - sh));
}

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

const uint QK_K = 256u;
const uint BLK = 144u;

void scale_min(uint j, uint u, out float sc, out float mn) {
    uint a = (w4[u + 1u + (j >> 2u)] >> ((j & 3u) * 8u)) & 0xFFu;
    uint b = (w4[u + 1u + ((j + 4u) >> 2u)] >> (((j + 4u) & 3u) * 8u)) & 0xFFu;
    uint c = (w4[u + 1u] >> ((j & 3u) * 8u)) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

vec4 nib(uint qw, bool hi) {
    return hi ? vec4(float((qw >> 4u) & 15u), float((qw >> 12u) & 15u), float((qw >> 20u) & 15u), float((qw >> 28u) & 15u))
              : vec4(float(qw & 15u), float((qw >> 8u) & 15u), float((qw >> 16u) & 15u), float((qw >> 24u) & 15u));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint rows_g = (pc.rows + 3u) / 4u;
    uint g = gl_WorkGroupID.x;
    uint slot = g / rows_g;
    if (slot >= pc.n_used) return;
    uint row0 = (g - slot * rows_g) * 4u;
    uint blocks = pc.cols / QK_K;
    uint rb = blocks * BLK;
    uint nr = min(4u, pc.rows - row0);
    uint plane = pc.base + ids[slot] * pc.plane_stride;
    uint base0 = plane + row0 * rb;
    uint b1 = base0 + min(1u, nr - 1u) * rb;
    uint b2 = base0 + min(2u, nr - 1u) * rb;
    uint b3 = base0 + min(3u, nr - 1u) * rb;
    uint x0 = slot * pc.x_stride;

    vec4 acc = vec4(0.0);
    uint sb = tid & 7u;
    uint h = sb >> 1u;
    bool hi = (sb & 1u) == 1u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint u0 = (base0 + b * BLK) >> 2u;
        uint u1 = (b1 + b * BLK) >> 2u;
        uint u2 = (b2 + b * BLK) >> 2u;
        uint u3 = (b3 + b * BLK) >> 2u;
        vec2 dd0 = unpackHalf2x16(w4[u0]);
        vec2 dd1 = unpackHalf2x16(w4[u1]);
        vec2 dd2 = unpackHalf2x16(w4[u2]);
        vec2 dd3 = unpackHalf2x16(w4[u3]);
        vec4 scv;
        vec4 mnv;
        scale_min(sb, u0, scv.x, mnv.x);
        scale_min(sb, u1, scv.y, mnv.y);
        scale_min(sb, u2, scv.z, mnv.z);
        scale_min(sb, u3, scv.w, mnv.w);
        uint q0 = u0 + 4u + h * 8u;
        uint q1 = u1 + 4u + h * 8u;
        uint q2 = u2 + 4u + h * 8u;
        uint q3 = u3 + 4u + h * 8u;
        uint xb4 = (x0 >> 2u) + b * 64u + sb * 8u;
        vec4 s_qx = vec4(0.0);
        float s_x = 0.0;
        for (uint j = 0u; j < 8u; j++) {
            vec4 xv = x4[xb4 + j];
            s_x += sum4(xv);
            s_qx.x += dot(nib(w4[q0 + j], hi), xv);
            s_qx.y += dot(nib(w4[q1 + j], hi), xv);
            s_qx.z += dot(nib(w4[q2 + j], hi), xv);
            s_qx.w += dot(nib(w4[q3 + j], hi), xv);
        }
        acc += vec4(dd0.x, dd1.x, dd2.x, dd3.x) * scv * s_qx - vec4(dd0.y, dd1.y, dd2.y, dd3.y) * mnv * s_x;
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) {
        vec4 r = red[0];
        o[slot * pc.rows + row0] = r.x;
        if (nr > 1u) o[slot * pc.rows + row0 + 1u] = r.y;
        if (nr > 2u) o[slot * pc.rows + row0 + 2u] = r.z;
        if (nr > 3u) o[slot * pc.rows + row0 + 3u] = r.w;
    }
}
