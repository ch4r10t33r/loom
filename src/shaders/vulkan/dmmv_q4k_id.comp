// Q4_K id-indexed matvec (ggml_mul_mat_id), vectorized; row arithmetic
// identical to dmmv_q4k.comp, deliberately.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint w4[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; uint base; } pc;
shared float red[64];

// Unaligned 4-byte load: the 22/34/210-byte block formats put fields at
// half-word offsets. The device layer pads every buffer by a word, so the
// word+1 read at the tail stays in bounds.
uint loadU32(uint byte_off) {
    uint word = byte_off >> 2u;
    uint sh = (byte_off & 3u) * 8u;
    if (sh == 0u) return w4[word];
    return (w4[word] >> sh) | (w4[word + 1u] << (32u - sh));
}

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

const uint QK_K = 256u;
const uint BLK = 144u;

void scale_min(uint j, uint u, out float sc, out float mn) {
    uint a = (w4[u + 1u + (j >> 2u)] >> ((j & 3u) * 8u)) & 0xFFu;
    uint b = (w4[u + 1u + ((j + 4u) >> 2u)] >> (((j + 4u) & 3u) * 8u)) & 0xFFu;
    uint c = (w4[u + 1u] >> ((j & 3u) * 8u)) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

void main() {
    uint g = gl_WorkGroupID.x;
    uint slot = g / pc.rows;
    if (slot >= pc.n_used) return;
    uint row = g - slot * pc.rows;
    uint tid = gl_LocalInvocationID.x;
    uint blocks = pc.cols / QK_K;
    uint row_base = pc.base + ids[slot] * pc.plane_stride + row * blocks * BLK;
    uint x0 = slot * pc.x_stride;

    // Thread t owns sub-block (t & 7) of super-blocks strided by 8; the
    // 32-byte quant run is eight word loads against eight vec4 x loads.
    float acc = 0.0;
    uint sb = tid & 7u;
    uint h = sb >> 1u;
    bool hi = (sb & 1u) == 1u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint u = (row_base + b * BLK) >> 2u; // BLK is word-aligned
        vec2 dd = unpackHalf2x16(w4[u]);
        float sc, mn;
        scale_min(sb, u, sc, mn);
        uint qbase = u + 4u + h * 8u;
        uint xb4 = (x0 >> 2u) + b * 64u + sb * 8u;
        float s_qx = 0.0;
        float s_x = 0.0;
        for (uint j = 0u; j < 8u; j++) {
            uint qw = w4[qbase + j];
            vec4 xv = x4[xb4 + j];
            vec4 q = hi ? vec4(float((qw >> 4u) & 15u), float((qw >> 12u) & 15u), float((qw >> 20u) & 15u), float((qw >> 28u) & 15u))
                        : vec4(float(qw & 15u), float((qw >> 8u) & 15u), float((qw >> 16u) & 15u), float((qw >> 24u) & 15u));
            s_qx += dot(q, xv);
            s_x += sum4(xv);
        }
        acc += dd.x * sc * s_qx - dd.y * mn * s_x;
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) o[slot * pc.rows + row] = red[0];
}
