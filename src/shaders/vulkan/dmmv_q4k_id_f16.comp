// Q4_K id-indexed matvec, f16 products -- SAFE ONLY for post-norm
// activations: products ~3e2, block partial sums ~1e4, under f16 max
// 65504. The down projection (SwiGLU-scaled input) must NOT use this.
// Row arithmetic otherwise identical to dmmv_q4k_id.comp.
// Q4_K id-indexed matvec, 128-bit loads; row arithmetic identical to
// dmmv_q4k.comp, deliberately.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uvec4 w16[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; uint base; } pc;
shared vec4 red[16];

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

// 6-bit scale/min for sub-block j, from the block's 16-byte header uvec4
// (d|dmin in .x, the twelve scale bytes in .y .z .w).
void scale_min(uint j, uvec4 hdr, out float sc, out float mn) {
    uint sh = (j & 3u) * 8u;
    uint a = ((j < 4u ? hdr.y : hdr.z) >> sh) & 0xFFu;
    uint b = ((j < 4u ? hdr.z : hdr.w) >> sh) & 0xFFu;
    uint c = (hdr.y >> sh) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

// unpack8 turns a masked word into four byte lanes in one instruction --
// the dequant-ALU trick llama.cpp's mul_mat_vec_q4_k.comp uses.
f16vec4 nib(uint qw, bool hi) {
    return f16vec4(unpack8((hi ? (qw >> 4u) : qw) & 0x0F0F0F0Fu));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint rows_g = (pc.rows + 3u) / 4u;
    uint g = gl_WorkGroupID.x;
    uint slot = g / rows_g;
    if (slot >= pc.n_used) return;
    uint row0 = (g - slot * rows_g) * 4u;
    uint blocks = pc.cols / 256u;
    uint rb16 = blocks * 9u;
    uint nr = min(4u, pc.rows - row0);
    // plane_stride and base arrive in bytes; both are 16-aligned for every
    // real q4_k tensor (row = blocks*144, W_v base = nope*row_bytes).
    uint plane16 = (pc.base >> 4u) + ids[slot] * (pc.plane_stride >> 4u);
    uint base0 = plane16 + row0 * rb16;
    uint r1 = base0 + min(1u, nr - 1u) * rb16;
    uint r2 = base0 + min(2u, nr - 1u) * rb16;
    uint r3 = base0 + min(3u, nr - 1u) * rb16;
    uint x0 = slot * pc.x_stride;

    vec4 acc = vec4(0.0);
    uint sb = tid & 7u;
    uint h = sb >> 1u;
    bool hi = (sb & 1u) == 1u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint u0 = base0 + b * 9u;
        uint u1 = r1 + b * 9u;
        uint u2 = r2 + b * 9u;
        uint u3 = r3 + b * 9u;
        uvec4 h0 = w16[u0];
        uvec4 h1 = w16[u1];
        uvec4 h2 = w16[u2];
        uvec4 h3 = w16[u3];
        vec4 scv;
        vec4 mnv;
        scale_min(sb, h0, scv.x, mnv.x);
        scale_min(sb, h1, scv.y, mnv.y);
        scale_min(sb, h2, scv.z, mnv.z);
        scale_min(sb, h3, scv.w, mnv.w);
        uint q0 = u0 + 1u + h * 2u;
        uint q1 = u1 + 1u + h * 2u;
        uint q2 = u2 + 1u + h * 2u;
        uint q3 = u3 + 1u + h * 2u;
        uint xb4 = (x0 >> 2u) + b * 64u + sb * 8u;
        f16vec4 s16 = f16vec4(0.0);
        float s_x = 0.0;
        for (uint jw = 0u; jw < 2u; jw++) {
            uvec4 w0 = w16[q0 + jw];
            uvec4 w1 = w16[q1 + jw];
            uvec4 w2 = w16[q2 + jw];
            uvec4 w3 = w16[q3 + jw];
            uint xj = xb4 + jw * 4u;
            vec4 xa32 = x4[xj];
            vec4 xb32 = x4[xj + 1u];
            vec4 xc32 = x4[xj + 2u];
            vec4 xd32 = x4[xj + 3u];
            s_x += sum4(xa32) + sum4(xb32) + sum4(xc32) + sum4(xd32);
            f16vec4 xa = f16vec4(xa32);
            f16vec4 xb = f16vec4(xb32);
            f16vec4 xc = f16vec4(xc32);
            f16vec4 xd = f16vec4(xd32);
            s16.x += dot(nib(w0.x, hi), xa) + dot(nib(w0.y, hi), xb) + dot(nib(w0.z, hi), xc) + dot(nib(w0.w, hi), xd);
            s16.y += dot(nib(w1.x, hi), xa) + dot(nib(w1.y, hi), xb) + dot(nib(w1.z, hi), xc) + dot(nib(w1.w, hi), xd);
            s16.z += dot(nib(w2.x, hi), xa) + dot(nib(w2.y, hi), xb) + dot(nib(w2.z, hi), xc) + dot(nib(w2.w, hi), xd);
            s16.w += dot(nib(w3.x, hi), xa) + dot(nib(w3.y, hi), xb) + dot(nib(w3.z, hi), xc) + dot(nib(w3.w, hi), xd);
        }
        vec4 s_qx = vec4(s16);
        acc += vec4(unpackHalf2x16(h0.x).x, unpackHalf2x16(h1.x).x, unpackHalf2x16(h2.x).x, unpackHalf2x16(h3.x).x) * scv * s_qx
             - vec4(unpackHalf2x16(h0.x).y, unpackHalf2x16(h1.x).y, unpackHalf2x16(h2.x).y, unpackHalf2x16(h3.x).y) * mnv * s_x;
    }

    acc = subgroupAdd(acc);
    if (subgroupElect()) red[gl_SubgroupID] = acc;
    barrier();
    if (tid == 0u) {
        vec4 r = vec4(0.0);
        for (uint s = 0u; s < gl_NumSubgroups; s++) r += red[s];
        o[slot * pc.rows + row0] = r.x;
        if (nr > 1u) o[slot * pc.rows + row0 + 1u] = r.y;
        if (nr > 2u) o[slot * pc.rows + row0 + 2u] = r.z;
        if (nr > 3u) o[slot * pc.rows + row0 + 3u] = r.w;
    }
}
