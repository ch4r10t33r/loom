// Q4_K matvec, 128-bit loads: the 16-byte block header (d, dmin, twelve
// scale bytes) is one uvec4, the 32-byte quant run two more -- the load
// width NVIDIA needs for full bandwidth. Four rows per workgroup.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uvec4 w16[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared vec4 red[64];

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

// 6-bit scale/min for sub-block j, from the block's 16-byte header uvec4
// (d|dmin in .x, the twelve scale bytes in .y .z .w).
void scale_min(uint j, uvec4 hdr, out float sc, out float mn) {
    uint sh = (j & 3u) * 8u;
    uint a = ((j < 4u ? hdr.y : hdr.z) >> sh) & 0xFFu;
    uint b = ((j < 4u ? hdr.z : hdr.w) >> sh) & 0xFFu;
    uint c = (hdr.y >> sh) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

// unpack8 turns a masked word into four byte lanes in one instruction --
// the dequant-ALU trick llama.cpp's mul_mat_vec_q4_k.comp uses.
vec4 nib(uint qw, bool hi) {
    return vec4(unpack8((hi ? (qw >> 4u) : qw) & 0x0F0F0F0Fu));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * 4u;
    if (row0 >= pc.rows) return;
    uint blocks = pc.cols / 256u;
    uint rb16 = blocks * 9u; // 144 bytes = 9 uvec4 per super-block
    uint nr = min(4u, pc.rows - row0);
    uint base0 = row0 * rb16;
    uint r1 = base0 + min(1u, nr - 1u) * rb16;
    uint r2 = base0 + min(2u, nr - 1u) * rb16;
    uint r3 = base0 + min(3u, nr - 1u) * rb16;
    uint x0 = 0u;

    vec4 acc = vec4(0.0);
    uint sb = tid & 7u;
    uint h = sb >> 1u;
    bool hi = (sb & 1u) == 1u;
    for (uint b = tid >> 3u; b < blocks; b += 8u) {
        uint u0 = base0 + b * 9u;
        uint u1 = r1 + b * 9u;
        uint u2 = r2 + b * 9u;
        uint u3 = r3 + b * 9u;
        uvec4 h0 = w16[u0];
        uvec4 h1 = w16[u1];
        uvec4 h2 = w16[u2];
        uvec4 h3 = w16[u3];
        vec4 scv;
        vec4 mnv;
        scale_min(sb, h0, scv.x, mnv.x);
        scale_min(sb, h1, scv.y, mnv.y);
        scale_min(sb, h2, scv.z, mnv.z);
        scale_min(sb, h3, scv.w, mnv.w);
        uint q0 = u0 + 1u + h * 2u;
        uint q1 = u1 + 1u + h * 2u;
        uint q2 = u2 + 1u + h * 2u;
        uint q3 = u3 + 1u + h * 2u;
        uint xb4 = (x0 >> 2u) + b * 64u + sb * 8u;
        vec4 s_qx = vec4(0.0);
        float s_x = 0.0;
        for (uint jw = 0u; jw < 2u; jw++) {
            uvec4 w0 = w16[q0 + jw];
            uvec4 w1 = w16[q1 + jw];
            uvec4 w2 = w16[q2 + jw];
            uvec4 w3 = w16[q3 + jw];
            uint xj = xb4 + jw * 4u;
            vec4 xa = x4[xj];
            vec4 xb = x4[xj + 1u];
            vec4 xc = x4[xj + 2u];
            vec4 xd = x4[xj + 3u];
            s_x += sum4(xa) + sum4(xb) + sum4(xc) + sum4(xd);
            s_qx.x += dot(nib(w0.x, hi), xa) + dot(nib(w0.y, hi), xb) + dot(nib(w0.z, hi), xc) + dot(nib(w0.w, hi), xd);
            s_qx.y += dot(nib(w1.x, hi), xa) + dot(nib(w1.y, hi), xb) + dot(nib(w1.z, hi), xc) + dot(nib(w1.w, hi), xd);
            s_qx.z += dot(nib(w2.x, hi), xa) + dot(nib(w2.y, hi), xb) + dot(nib(w2.z, hi), xc) + dot(nib(w2.w, hi), xd);
            s_qx.w += dot(nib(w3.x, hi), xa) + dot(nib(w3.y, hi), xb) + dot(nib(w3.z, hi), xc) + dot(nib(w3.w, hi), xd);
        }
        acc += vec4(unpackHalf2x16(h0.x).x, unpackHalf2x16(h1.x).x, unpackHalf2x16(h2.x).x, unpackHalf2x16(h3.x).x) * scv * s_qx
             - vec4(unpackHalf2x16(h0.x).y, unpackHalf2x16(h1.x).y, unpackHalf2x16(h2.x).y, unpackHalf2x16(h3.x).y) * mnv * s_x;
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) {
        vec4 r = red[0];
        o[row0] = r.x;
        if (nr > 1u) o[row0 + 1u] = r.y;
        if (nr > 2u) o[row0 + 2u] = r.z;
        if (nr > 3u) o[row0 + 3u] = r.w;
    }
}
