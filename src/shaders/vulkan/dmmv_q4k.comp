// Q4_K matvec in llama.cpp mul_mat_vec_q4_k shape: 128-thread workgroups,
// 16 threads per super-block, 128-bit loads, four rows sharing every
// activation read. Value = d*sc*q - dmin*m, unchanged.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer W { uvec4 w16[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared vec4 red[16];

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

// 6-bit scale/min for sub-block j, from the block's 16-byte header uvec4
// (d|dmin in .x, the twelve scale bytes in .y .z .w).
void scale_min(uint j, uvec4 hdr, out float sc, out float mn) {
    uint sh = (j & 3u) * 8u;
    uint a = ((j < 4u ? hdr.y : hdr.z) >> sh) & 0xFFu;
    uint b = ((j < 4u ? hdr.z : hdr.w) >> sh) & 0xFFu;
    uint c = (hdr.y >> sh) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

vec4 nib(uint qw, bool hi) {
    return vec4(unpack8((hi ? (qw >> 4u) : qw) & 0x0F0F0F0Fu));
}

// One row's whole contribution for this thread's 16 values: the y1/y2 pairs
// of qs0/qs64 against their four scale pairs -- llama.cpp's
// mul_mat_vec_q4_k per-thread shape.
float rowPart(uvec4 hdr, uint qbase, uint v_im, vec4 xa, vec4 xb, vec4 xc, vec4 xd) {
    vec2 dd = unpackHalf2x16(hdr.x);
    float scA;
    float mnA;
    float scB;
    float mnB;
    float scC;
    float mnC;
    float scD;
    float mnD;
    scale_min(2u * v_im, hdr, scA, mnA);
    scale_min(2u * v_im + 1u, hdr, scB, mnB);
    scale_min(2u * v_im + 4u, hdr, scC, mnC);
    scale_min(2u * v_im + 5u, hdr, scD, mnD);
    // qbase is a u32 word index; select the word inside its uvec4.
    uint qa = w16[qbase >> 2u][qbase & 3u];
    uint qb = w16[(qbase + 16u) >> 2u][(qbase + 16u) & 3u];
    float s = scA * dot(nib(qa, false), xa) + scB * dot(nib(qa, true), xb) + scC * dot(nib(qb, false), xc) + scD * dot(nib(qb, true), xd);
    float m = mnA * sum4(xa) + mnB * sum4(xb) + mnC * sum4(xc) + mnD * sum4(xd);
    return dd.x * s - dd.y * m;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * 4u;
    if (row0 >= pc.rows) return;
    uint blocks = pc.cols / 256u;
    uint rb16 = blocks * 9u;
    uint nr = min(4u, pc.rows - row0);
    uint base0 = row0 * rb16;
    uint r1 = base0 + min(1u, nr - 1u) * rb16;
    uint r2 = base0 + min(2u, nr - 1u) * rb16;
    uint r3 = base0 + min(3u, nr - 1u) * rb16;
    uint x0 = 0u;

    // llama.cpp's thread map: itid 0..15 covers one super-block -- v_im picks
    // the 128-half, v_in the 4-value column -- so a warp's quant loads are
    // contiguous; ix strides super-blocks 8 at a time. Four rows share every
    // activation load.
    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint v_im = itid >> 3u;
    uint v_in = itid & 7u;
    uint qoff = 4u + 8u * v_im + v_in; // u32 word of qs[32*v_im + 4*v_in]
    vec4 acc = vec4(0.0);
    for (uint b = ix; b < blocks; b += 8u) {
        uint xb4 = (x0 >> 2u) + b * 64u + 16u * v_im + v_in;
        vec4 xa = x4[xb4];
        vec4 xb = x4[xb4 + 8u];
        vec4 xc = x4[xb4 + 32u];
        vec4 xd = x4[xb4 + 40u];
        acc.x += rowPart(w16[base0 + b * 9u], (base0 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd);
        acc.y += rowPart(w16[r1 + b * 9u], (r1 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd);
        acc.z += rowPart(w16[r2 + b * 9u], (r2 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd);
        acc.w += rowPart(w16[r3 + b * 9u], (r3 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd);
    }

    acc = subgroupAdd(acc);
    if (subgroupElect()) red[gl_SubgroupID] = acc;
    barrier();
    if (tid == 0u) {
        vec4 r = vec4(0.0);
        for (uint s = 0u; s < gl_NumSubgroups; s++) r += red[s];
        o[row0] = r.x;
        if (nr > 1u) o[row0 + 1u] = r.y;
        if (nr > 2u) o[row0 + 2u] = r.z;
        if (nr > 3u) o[row0 + 3u] = r.w;
    }
}
