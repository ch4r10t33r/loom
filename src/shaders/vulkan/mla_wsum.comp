// o_latent[h][i] = sum_t probs[h][t] * c[t][i] -- the value side of MLA in
// compressed space. Same coalesced tile shape as mla_absorb: thread j owns
// output i and walks positions serially, so the cache reads are consecutive
// across the workgroup.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer P { float probs[]; };
layout(std430, binding = 1) readonly buffer C { float c_cache[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n_heads; uint kvr; uint seq; uint c_base; } pc;

void main() {
    uint tiles = (pc.kvr + 63u) / 64u;
    uint g = gl_WorkGroupID.x;
    uint h = g / tiles;
    if (h >= pc.n_heads) return;
    uint i = (g - h * tiles) * 64u + gl_LocalInvocationID.x;
    if (i >= pc.kvr) return;
    uint ph = h * pc.seq;
    float acc = 0.0;
    for (uint t = 0u; t < pc.seq; t++) acc += probs[ph + t] * c_cache[pc.c_base + t * pc.kvr + i];
    o[h * pc.kvr + i] = acc;
}
