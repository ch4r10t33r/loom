// F32 matvec, four rows per workgroup -- the MoE router and any other
// unquantized tensor.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared vec4 red[64];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * 4u;
    if (row0 >= pc.rows) return;
    uint nr = min(4u, pc.rows - row0);
    uint g0 = row0 * pc.cols;
    uint g1 = g0 + min(1u, nr - 1u) * pc.cols;
    uint g2 = g0 + min(2u, nr - 1u) * pc.cols;
    uint g3 = g0 + min(3u, nr - 1u) * pc.cols;
    vec4 acc = vec4(0.0);
    for (uint i = tid; i < pc.cols; i += 64u) {
        float xv = x[i];
        acc += vec4(w[g0 + i], w[g1 + i], w[g2 + i], w[g3 + i]) * xv;
    }
    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) {
        vec4 r = red[0];
        o[row0] = r.x;
        if (nr > 1u) o[row0 + 1u] = r.y;
        if (nr > 2u) o[row0 + 2u] = r.z;
        if (nr > 3u) o[row0 + 3u] = r.w;
    }
}
