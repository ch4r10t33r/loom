// Q4_K id-indexed matvec with integer-quantized activations: the masked
// quant word IS a packed i8x4, so the whole dequant collapses into
// dotPacked4x8 -- llama.cpp's mul_mat_vec_q shape. Activations arrive as
// q8_1-style blocks from quant_act.comp; safe wherever the int8 activation
// approximation is (the CPU path's standing trade). Same thread map and
// grid as dmmv_q4k_id.comp.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer W { uvec4 w16[]; };
layout(std430, binding = 1) readonly buffer XQ { uint xq[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; uint base; uint d_off; uint s_off; } pc;
shared vec4 red[16];

void scale_min(uint j, uvec4 hdr, out float sc, out float mn) {
    uint sh = (j & 3u) * 8u;
    uint a = ((j < 4u ? hdr.y : hdr.z) >> sh) & 0xFFu;
    uint b = ((j < 4u ? hdr.z : hdr.w) >> sh) & 0xFFu;
    uint c = (hdr.y >> sh) & 0xFFu;
    if (j < 4u) {
        sc = float(a & 63u);
        mn = float(b & 63u);
    } else {
        sc = float((b & 0xFu) | ((c >> 6u) << 4u));
        mn = float((b >> 4u) | ((a >> 6u) << 4u));
    }
}

float rowPart(uvec4 hdr, uint qbase, uint v_im, uint xa, uint xb, uint xc, uint xd, vec4 dx, vec4 sx, bool lead) {
    vec2 dd = unpackHalf2x16(hdr.x);
    float scA;
    float mnA;
    float scB;
    float mnB;
    float scC;
    float mnC;
    float scD;
    float mnD;
    scale_min(2u * v_im, hdr, scA, mnA);
    scale_min(2u * v_im + 1u, hdr, scB, mnB);
    scale_min(2u * v_im + 4u, hdr, scC, mnC);
    scale_min(2u * v_im + 5u, hdr, scD, mnD);
    uint qa = w16[qbase >> 2u][qbase & 3u];
    uint qb = w16[(qbase + 16u) >> 2u][(qbase + 16u) & 3u];
    float s = scA * dx.x * float(dotPacked4x8EXT(int(qa & 0x0F0F0F0Fu), int(xa)))
            + scB * dx.y * float(dotPacked4x8EXT(int((qa >> 4u) & 0x0F0F0F0Fu), int(xb)))
            + scC * dx.z * float(dotPacked4x8EXT(int(qb & 0x0F0F0F0Fu), int(xc)))
            + scD * dx.w * float(dotPacked4x8EXT(int((qb >> 4u) & 0x0F0F0F0Fu), int(xd)));
    float m = lead ? (mnA * dx.x * sx.x + mnB * dx.y * sx.y + mnC * dx.z * sx.z + mnD * dx.w * sx.w) : 0.0;
    return dd.x * s - dd.y * m;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint rows_g = (pc.rows + 3u) / 4u;
    uint g = gl_WorkGroupID.x;
    uint slot = g / rows_g;
    if (slot >= pc.n_used) return;
    uint row0 = (g - slot * rows_g) * 4u;
    uint blocks = pc.cols / 256u;
    uint rb16 = blocks * 9u;
    uint nr = min(4u, pc.rows - row0);
    uint plane16 = (pc.base >> 4u) + ids[slot] * (pc.plane_stride >> 4u);
    uint base0 = plane16 + row0 * rb16;
    uint r1 = base0 + min(1u, nr - 1u) * rb16;
    uint r2 = base0 + min(2u, nr - 1u) * rb16;
    uint r3 = base0 + min(3u, nr - 1u) * rb16;
    uint x0 = slot * pc.x_stride; // floats == bytes of q

    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint v_im = itid >> 3u;
    uint v_in = itid & 7u;
    bool lead = v_in == 0u;
    uint qoff = 4u + 8u * v_im + v_in;
    vec4 acc = vec4(0.0);
    for (uint b = ix; b < blocks; b += 8u) {
        uint y1 = x0 + b * 256u + 64u * v_im + 4u * v_in;
        uint xa = xq[y1 >> 2u];
        uint xb = xq[(y1 + 32u) >> 2u];
        uint xc = xq[(y1 + 128u) >> 2u];
        uint xd = xq[(y1 + 160u) >> 2u];
        uint sb = (x0 >> 5u) + b * 8u + 2u * v_im;
        vec4 dx = vec4(uintBitsToFloat(xq[pc.d_off + sb]), uintBitsToFloat(xq[pc.d_off + sb + 1u]), uintBitsToFloat(xq[pc.d_off + sb + 4u]), uintBitsToFloat(xq[pc.d_off + sb + 5u]));
        vec4 sx = vec4(uintBitsToFloat(xq[pc.s_off + sb]), uintBitsToFloat(xq[pc.s_off + sb + 1u]), uintBitsToFloat(xq[pc.s_off + sb + 4u]), uintBitsToFloat(xq[pc.s_off + sb + 5u]));
        acc.x += rowPart(w16[base0 + b * 9u], (base0 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd, dx, sx, lead);
        acc.y += rowPart(w16[r1 + b * 9u], (r1 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd, dx, sx, lead);
        acc.z += rowPart(w16[r2 + b * 9u], (r2 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd, dx, sx, lead);
        acc.w += rowPart(w16[r3 + b * 9u], (r3 + b * 9u) * 4u + qoff, v_im, xa, xb, xc, xd, dx, sx, lead);
    }

    acc = subgroupAdd(acc);
    if (subgroupElect()) red[gl_SubgroupID] = acc;
    barrier();
    if (tid == 0u) {
        vec4 r = vec4(0.0);
        for (uint s = 0u; s < gl_NumSubgroups; s++) r += red[s];
        o[slot * pc.rows + row0] = r.x;
        if (nr > 1u) o[slot * pc.rows + row0 + 1u] = r.y;
        if (nr > 2u) o[slot * pc.rows + row0 + 2u] = r.z;
        if (nr > 3u) o[slot * pc.rows + row0 + 3u] = r.w;
    }
}
