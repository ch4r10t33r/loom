// a[i] = silu(a[i]) * b[i] over n elements -- every selected expert's SwiGLU
// in one dispatch, same as swiglu_slots in elementwise.metal.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.n) return;
    float g = a[gid];
    a[gid] = (g / (1.0 + exp(-g))) * b[gid];
}
