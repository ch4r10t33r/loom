// Q5_0 id-indexed matvec, four rows per workgroup; row arithmetic
// identical to dmmv_q5_0.comp.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint w4[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(std430, binding = 3) readonly buffer I { uint ids[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint n_used; uint plane_stride; uint x_stride; uint base; } pc;
shared vec4 red[16];

// Unaligned 4-byte load: the 22/34/210-byte block formats put fields at
// half-word offsets. The device layer pads every buffer by a word, so the
// word+1 read at the tail stays in bounds.
uint loadU32(uint byte_off) {
    uint word = byte_off >> 2u;
    uint sh = (byte_off & 3u) * 8u;
    if (sh == 0u) return w4[word];
    return (w4[word] >> sh) | (w4[word + 1u] << (32u - sh));
}

float sum4(vec4 v) { return v.x + v.y + v.z + v.w; }

const uint QK = 32u;
const uint BLK = 24u; // padded at upload: [16 qs][4 qh][d half][2 pad], word-aligned

vec4 q5lo(uint qw, uint qh, uint i) {
    return vec4(float((qw & 15u) | (((qh >> i) & 1u) << 4u)),
                float(((qw >> 8u) & 15u) | (((qh >> (i + 1u)) & 1u) << 4u)),
                float(((qw >> 16u) & 15u) | (((qh >> (i + 2u)) & 1u) << 4u)),
                float(((qw >> 24u) & 15u) | (((qh >> (i + 3u)) & 1u) << 4u)));
}

vec4 q5hi(uint qw, uint qh, uint i) {
    return vec4(float(((qw >> 4u) & 15u) | (((qh >> (i + 16u)) & 1u) << 4u)),
                float(((qw >> 12u) & 15u) | (((qh >> (i + 17u)) & 1u) << 4u)),
                float(((qw >> 20u) & 15u) | (((qh >> (i + 18u)) & 1u) << 4u)),
                float(((qw >> 28u) & 15u) | (((qh >> (i + 19u)) & 1u) << 4u)));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint rows_g = (pc.rows + 3u) / 4u;
    uint g = gl_WorkGroupID.x;
    uint slot = g / rows_g;
    if (slot >= pc.n_used) return;
    uint row0 = (g - slot * rows_g) * 4u;
    uint blocks = pc.cols / QK;
    uint rb = blocks * BLK;
    uint nr = min(4u, pc.rows - row0);
    uint plane = pc.base + ids[slot] * pc.plane_stride;
    uint base0 = plane + row0 * rb;
    uint b1 = base0 + min(1u, nr - 1u) * rb;
    uint b2 = base0 + min(2u, nr - 1u) * rb;
    uint b3 = base0 + min(3u, nr - 1u) * rb;
    uint x0 = slot * pc.x_stride;

    vec4 acc = vec4(0.0);
    for (uint b = tid; b < blocks; b += 64u) {
        uint k0 = base0 + b * BLK;
        uint k1 = b1 + b * BLK;
        uint k2 = b2 + b * BLK;
        uint k3 = b3 + b * BLK;
        vec4 d = vec4(unpackHalf2x16(w4[(k0 + 20u) >> 2u]).x, unpackHalf2x16(w4[(k1 + 20u) >> 2u]).x, unpackHalf2x16(w4[(k2 + 20u) >> 2u]).x, unpackHalf2x16(w4[(k3 + 20u) >> 2u]).x);
        uint h0 = w4[(k0 + 16u) >> 2u];
        uint h1 = w4[(k1 + 16u) >> 2u];
        uint h2 = w4[(k2 + 16u) >> 2u];
        uint h3 = w4[(k3 + 16u) >> 2u];
        uint xb4 = (x0 >> 2u) + b * 8u;
        vec4 s_qx = vec4(0.0);
        float s_x = 0.0;
        for (uint j = 0u; j < 4u; j++) {
            uint i = 4u * j;
            uint off = i;
            vec4 xlo = x4[xb4 + j];
            vec4 xhi = x4[xb4 + 4u + j];
            s_x += sum4(xlo) + sum4(xhi);
            uint w0 = w4[(k0 + off) >> 2u];
            uint w1 = w4[(k1 + off) >> 2u];
            uint w2 = w4[(k2 + off) >> 2u];
            uint w3 = w4[(k3 + off) >> 2u];
            s_qx.x += dot(q5lo(w0, h0, i), xlo) + dot(q5hi(w0, h0, i), xhi);
            s_qx.y += dot(q5lo(w1, h1, i), xlo) + dot(q5hi(w1, h1, i), xhi);
            s_qx.z += dot(q5lo(w2, h2, i), xlo) + dot(q5hi(w2, h2, i), xhi);
            s_qx.w += dot(q5lo(w3, h3, i), xlo) + dot(q5hi(w3, h3, i), xhi);
        }
        acc += d * (s_qx - 16.0 * s_x);
    }

    acc = subgroupAdd(acc);
    if (subgroupElect()) red[gl_SubgroupID] = acc;
    barrier();
    if (tid == 0u) {
        vec4 r = vec4(0.0);
        for (uint s = 0u; s < gl_NumSubgroups; s++) r += red[s];
        o[slot * pc.rows + row0] = r.x;
        if (nr > 1u) o[slot * pc.rows + row0 + 1u] = r.y;
        if (nr > 2u) o[slot * pc.rows + row0 + 2u] = r.z;
        if (nr > 3u) o[slot * pc.rows + row0 + 3u] = r.w;
    }
}
